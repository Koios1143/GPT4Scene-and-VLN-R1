# Copy to env.sh (gitignored) and fill in. Every extra_eval/*.sh sources it from the repo root.
# The ${VAR:-...} form lets a value given on the command line override this file.
# Unset variables fall back to the defaults listed in each script's header.

# --- environment (build_env.sh) ---
export GPT4SCENE_ENV="${GPT4SCENE_ENV:-/path/to/gpt4scene-venv}"
export UV_CACHE_DIR="${UV_CACHE_DIR:-/path/to/cache/uv}"
export HF_HOME="${HF_HOME:-/path/to/cache/huggingface}"
# export TMPDIR=/path/to/tmp

# --- downloads (download.sh) and inference (run_*.sh) ---
export MODEL_PATH="${MODEL_PATH:-/path/to/GPT4Scene-qwen2vl_full_sft_mark_32_3D_img512}"  # HF alexzyqi/GPT4Scene-qwen2vl_full_sft_mark_32_3D_img512
export GPT4SCENE_ANNO="${GPT4SCENE_ANNO:-/path/to/GPT4Scene-Val-Annotation}"            # HF dataset alexzyqi/GPT4Scene-Val-Annotation
export GPT4SCENE_DATA="${GPT4SCENE_DATA:-/path/to/GPT4Scene-All}"                       # HF dataset alexzyqi/GPT4Scene-All, unzipped (images_2D/, images_3D/)

# --- scoring (score_beacon3d.sh) ---
export OPENAI_API_KEY="${OPENAI_API_KEY:-sk-...}"
